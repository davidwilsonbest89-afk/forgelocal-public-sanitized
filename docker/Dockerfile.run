FROM ubuntu:24.04

ARG TARGETARCH
ARG TARGETPLATFORM
ARG BROWSEFORGE_VERSION
ARG BROWSEFORGE_ARCH
ARG KASMVNC_VERSION=1.4.0
ARG KASMVNC_SHA256_AMD64=12bac6014149c5fdee75f0d403785aaa3e5dd4ea222de73253a5d4181bc9567e
ARG KASMVNC_SHA256_ARM64=120d9462cb5e917cad91a23f6cb0b780c06f701def40e900b29f996979200638

ENV DEBIAN_FRONTEND=noninteractive \
    DISPLAY=:1 \
    BROWSEFORGE_DOCKER_GPU_MODE=software \
    BROWSEFORGE_DOCKER_DISPLAY_WIDTH=1920 \
    BROWSEFORGE_DOCKER_DISPLAY_HEIGHT=1080

# System deps + browser runtime libs
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl unzip ca-certificates \
    libnss3 libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 \
    libxkbcommon0 libxcomposite1 libxdamage1 libxrandr2 libgbm1 \
    libpango-1.0-0 libcairo2 libasound2t64 libxshmfence1 \
    libgtk-3-0 libdbus-glib-1-2 libxt6 \
    fonts-noto-core fonts-noto-cjk fonts-noto-color-emoji fonts-liberation2 fonts-dejavu-core \
    openbox \
    libegl1 libgles2 \
    && rm -rf /var/lib/apt/lists/*

# Install KasmVNC (replaces Xvfb + x11vnc + noVNC + websockify)
# KasmVNC is run below with explicit non-TLS flags; do not ship the package-generated snakeoil key.
RUN target_arch="${TARGETARCH:-$(dpkg --print-architecture)}" && \
    case "$target_arch" in \
      amd64) KASMVNC_DEB_ARCH=amd64; KASMVNC_SHA256="$KASMVNC_SHA256_AMD64" ;; \
      arm64) KASMVNC_DEB_ARCH=arm64; KASMVNC_SHA256="$KASMVNC_SHA256_ARM64" ;; \
      *) echo "unsupported Docker target architecture for KasmVNC: ${target_arch}" >&2; exit 1 ;; \
    esac && \
    KASMVNC_URL="https://github.com/kasmtech/KasmVNC/releases/download/v${KASMVNC_VERSION}/kasmvncserver_noble_${KASMVNC_VERSION}_${KASMVNC_DEB_ARCH}.deb" && \
    echo "Downloading: $KASMVNC_URL" && \
    curl -fSL -o /tmp/kasmvnc.deb "$KASMVNC_URL" && \
    echo "${KASMVNC_SHA256}  /tmp/kasmvnc.deb" | sha256sum -c - && \
    apt-get update && apt-get install -y /tmp/kasmvnc.deb && \
    rm -f /etc/ssl/certs/ssl-cert-snakeoil.pem /etc/ssl/certs/ssl-cert-snakeoil.pem.broken \
          /etc/ssl/private/ssl-cert-snakeoil.key /etc/ssl/private/ssl-cert-snakeoil.key.broken \
          /etc/systemd/system/multi-user.target.wants/ssl-cert.service && \
    find /etc/ssl/certs -maxdepth 1 -lname ssl-cert-snakeoil.pem -delete 2>/dev/null || true && \
    rm -f /tmp/kasmvnc.deb && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Download the exact BrowseForge release selected by the workflow/build args.
ARG BROWSEFORGE_RELEASE_BASE_URL=https://github.com/nczz/BrowseForge/releases/download
ARG BROWSEFORGE_PREINSTALL_BROWSERS=1
ARG BROWSEFORGE_PREINSTALL_RUNTIMES=camoufox,browseforge-chromium
ARG BROWSEFORGE_CHROMIUM_RELEASE_BASE_URL
ENV BROWSEFORGE_CHROMIUM_RELEASE_BASE_URL=${BROWSEFORGE_CHROMIUM_RELEASE_BASE_URL}
RUN test -n "$BROWSEFORGE_VERSION" && \
    target_arch="${TARGETARCH:-$(dpkg --print-architecture)}" && \
    browseforge_arch="$BROWSEFORGE_ARCH" && \
    if [ -z "$browseforge_arch" ]; then \
      case "$target_arch" in \
        amd64) browseforge_arch=linux-x64 ;; \
        arm64) browseforge_arch=linux-arm64 ;; \
        *) echo "unsupported Docker target architecture for BrowseForge: ${target_arch}" >&2; exit 1 ;; \
      esac; \
    fi && \
    URL="${BROWSEFORGE_RELEASE_BASE_URL}/${BROWSEFORGE_VERSION}/BrowseForge-${BROWSEFORGE_VERSION}-lite-${browseforge_arch}.zip" && \
    echo "Downloading: $URL" && \
    curl -fSL -o /tmp/bf.zip "$URL" && \
    unzip /tmp/bf.zip -d /tmp && \
    mv /tmp/BrowseForge-lite/* /app/ && \
    rm -rf /tmp/bf.zip /tmp/BrowseForge-lite && \
    chmod +x /app/BrowseForge

# Preinstall the Playwright control driver so runtime startup does not depend on
# downloading playwright-core or Node.js from npm/nodejs.org.
RUN if /app/BrowseForge --help 2>/dev/null | grep -q "playwright install-driver"; then \
      /app/BrowseForge playwright install-driver; \
    else \
      echo "Skipping Playwright driver preinstall for this BrowseForge binary"; \
    fi

# Newer BrowseForge releases can preinstall browser engines during image build.
# Older release binaries skip this step so historical builds remain reproducible.
RUN if [ "$BROWSEFORGE_PREINSTALL_BROWSERS" = "1" ] && /app/BrowseForge --help 2>/dev/null | grep -q "browsers status"; then \
      /app/BrowseForge --base-dir /opt/browseforge browsers install --runtimes "$BROWSEFORGE_PREINSTALL_RUNTIMES"; \
    else \
      echo "Skipping browser preinstall for this BrowseForge binary"; \
    fi

EXPOSE 19280 6901

COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
