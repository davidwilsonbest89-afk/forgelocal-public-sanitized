# Values are supplied only by the authorized local smoke environment.
# Never commit real tokens or credentials here.
SMOKE_CORE_URL=http://127.0.0.1:19281
SMOKE_DASHBOARD_URL=http://127.0.0.1:3001
SMOKE_ADMIN_TOKEN=<RUNTIME_ONLY_REDACTED>
SMOKE_READONLY_CODE=<RUNTIME_ONLY_REDACTED_OPTIONAL>
SMOKE_ALPHA_PROXY_USER=<RUNTIME_ONLY_SYNTHETIC>
SMOKE_ALPHA_PROXY_PASS=<RUNTIME_ONLY_SYNTHETIC>
SMOKE_BETA_PROXY_USER=<RUNTIME_ONLY_SYNTHETIC>
SMOKE_BETA_PROXY_PASS=<RUNTIME_ONLY_SYNTHETIC>
SMOKE_BAD_PROXY_EXPECTED_USER=<RUNTIME_ONLY_SYNTHETIC>
SMOKE_BAD_PROXY_EXPECTED_PASS=<RUNTIME_ONLY_SYNTHETIC>
# Optional when the local pnpm path differs from the repository default.
# PLAYWRIGHT_CORE_PATH=/absolute/path/to/playwright-core/index.mjs
